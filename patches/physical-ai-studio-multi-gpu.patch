+    Volume and only weights travel to the laptop. Without the environment variable nothing changes.
+    """
+    target = os.environ.get(FULL_CHECKPOINT_DIR_ENV)
+    if not target:
+        return
+    import torch
+
+    target_dir = Path(target)
+    for name in (CHECKPOINT_NAME, SNAPFLOW_CHECKPOINT_NAME):
+        checkpoint = cache_dir / name
+        if not checkpoint.is_file():
+            continue
+        state = torch.load(checkpoint, map_location="cpu", mmap=True, weights_only=False)
+        if not state.get("optimizer_states") and not state.get("lr_schedulers"):
+            continue
+        target_dir.mkdir(parents=True, exist_ok=True)
+        # Temporary name first: a restart treats a file under the final name as a finished run.
+        shutil.copy2(checkpoint, target_dir / f"{name}.tmp")
+        (target_dir / f"{name}.tmp").replace(target_dir / name)
+        slim = {key: value for key, value in state.items() if key not in ("optimizer_states", "lr_schedulers")}
+        partial = checkpoint.with_suffix(".slim.tmp")
+        torch.save(slim, partial)
+        del state, slim
+        partial.replace(checkpoint)
+        logger.info("Kept the full %s in %s; shipping weights only", name, target_dir)
+
