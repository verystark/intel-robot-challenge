+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+"""A restarted job whose full checkpoint already exists exports it instead of training again."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+import torch
+
+from training import job
+from training.job import TrainingJobSpec
+
+
+def _full_checkpoint(path: Path) -> None:
+    torch.save(
+        {
+            "global_step": 42,
+            "state_dict": {"layer.weight": torch.ones(2, 2)},
+            "optimizer_states": [{"state": {}}],
+            "lr_schedulers": [{"last_epoch": 42}],
+            "hyper_parameters": {"width": 2},
+        },
+        path,
+    )
+
+
+def test_restart_exports_saved_checkpoint_without_training(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    saved = tmp_path / "volume" / "full-checkpoint" / "model.ckpt"
+    saved.parent.mkdir(parents=True)
+    _full_checkpoint(saved)
+    monkeypatch.setenv(job.COMPLETED_CHECKPOINT_ENV, str(saved))
+    exported: list[Path] = []
+    monkeypatch.setattr(job, "_export_policy", lambda spec, output_dir: ("policy", output_dir))
+    monkeypatch.setattr(job, "_export", lambda policy, output_dir, report, backends: exported.append(output_dir))
+    monkeypatch.setattr(
+        "training.multi_gpu.launch", lambda *a, **k: pytest.fail("must not launch training on a restart")
+    )
+
+    output_dir, cache_dir = tmp_path / "model", tmp_path / "cache"
+    job.run_training_job(
+        TrainingJobSpec(policy="act", max_epochs=1),
+        dataset_root=tmp_path / "dataset",
+        output_dir=output_dir,
+        cache_dir=cache_dir,
+        report=lambda *a: None,
+        should_stop=lambda: False,
+    )
+
+    shipped = torch.load(output_dir / job.CHECKPOINT_NAME, weights_only=False)
+    assert "optimizer_states" not in shipped and shipped["global_step"] == 42
+    assert exported == [output_dir]
+    assert saved.is_file()  # the full checkpoint on the Volume is left alone
