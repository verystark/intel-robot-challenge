index 00000000..600718f6
--- /dev/null
+++ b/application/backend/src/training/multi_gpu.py
@@ -0,0 +1,185 @@
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+"""Multi-GPU training: one fresh process per GPU, started with ``torchrun``.
+
+Junction 2026 station addition (see GPU_SCALING.md in the team repo). A training job that is given
+more than one GPU (``PHYSICALAI_NUM_GPUS`` > 1) is not trained in the calling process. Instead
+:func:`launch` starts ``torchrun``, which runs :func:`main` once per GPU; each of those calls the
+normal :func:`training.job.run_training_job`, and Lightning's DDP strategy sees that torchrun created
+the processes and launches nothing itself.
+
+Why not fork: forked ranks can't use CUDA once the parent process has touched it, and library code
+(model loading, Hugging Face) does that before training starts. Fresh processes avoid the problem.
+
+Only the calling process talks to the outside world: rank 0 writes progress lines to a file, and
+:func:`launch` forwards them to the caller's ``report`` (which, on Modal, writes ``status.json`` and
+commits the Volume).
+"""
+
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from physicalai.train.callbacks import ReportFn, StopFn
+
+    from training.job import TrainingJobSpec
+
+_POLL_S = 2.0
+_TAIL_LINES = 60
+
+
+def under_torchrun() -> bool:
+    """True inside a process that torchrun started."""
+    return "TORCHELASTIC_RUN_ID" in os.environ or "LOCAL_RANK" in os.environ
+
+
+def launch(
+    spec: TrainingJobSpec,
+    *,
+    gpus: int,
+    dataset_root: Path | str,
+    output_dir: Path | str,
+    cache_dir: Path | str,
+    report: ReportFn,
+    should_stop: StopFn,
+) -> None:
+    """Run the training job on ``gpus`` GPUs with torchrun and wait for it.
+
+    Raises:
+        RuntimeError: If torchrun exits with an error (the last log lines are in the message).
+    """
+    cache_dir = Path(cache_dir)
+    # Outside cache_dir: rank 0 moves cache_dir to output_dir when training ends.
+    work_dir = cache_dir.parent / f"{cache_dir.name}.multi-gpu"
+    work_dir.mkdir(parents=True, exist_ok=True)
+    spec_path = work_dir / "spec.json"
+    progress_path = work_dir / "progress.jsonl"
+    # run_options can hold a token; the ranks read HF_TOKEN from the environment instead.
+    spec_path.write_text(spec.model_dump_json(exclude={"run_options"}))
+    progress_path.write_text("")
+
+    command = [
+        sys.executable, "-m", "torch.distributed.run",
+        "--standalone", f"--nproc_per_node={gpus}",
+        "-m", "training.multi_gpu",
+        "--spec", str(spec_path),
+        "--dataset", str(dataset_root),
+        "--output", str(output_dir),
+        "--cache", str(cache_dir),
+        "--progress", str(progress_path),
+    ]  # fmt: skip
+    print(f"Starting {gpus}-GPU training: {' '.join(command)}", flush=True)
+    process = subprocess.Popen(  # noqa: S603 - fixed command built above
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        bufsize=1,
+        env=os.environ.copy(),
+    )
+
+    tail: collections.deque[str] = collections.deque(maxlen=_TAIL_LINES)
+
+    def echo_output() -> None:
+        assert process.stdout is not None
+        for line in process.stdout:
+            sys.stdout.write(line)
+            sys.stdout.flush()
+            tail.append(line.rstrip())
+
+    echo = threading.Thread(target=echo_output, name="torchrun-output", daemon=True)
+    echo.start()
+
+    offset = 0
+    stopped = False
+    while process.poll() is None:
+        offset = _forward_progress(progress_path, offset, report)
+        if not stopped and should_stop():
+            stopped = True
+            process.terminate()
+        time.sleep(_POLL_S)
+    echo.join(timeout=10)
+    _forward_progress(progress_path, offset, report)
+
+    if process.returncode != 0 and not stopped:
+        details = "\n".join(tail)
+        msg = f"Multi-GPU training failed (torchrun exit code {process.returncode}). Last output:\n{details}"
+        raise RuntimeError(msg)
+
+
+def _forward_progress(path: Path, offset: int, report: ReportFn) -> int:
+    """Pass every complete progress line written since ``offset`` to ``report``."""
+    try:
+        with path.open() as handle:
+            handle.seek(offset)
+            while True:
+                line = handle.readline()
+                if not line.endswith("\n"):
+                    break
+                offset = handle.tell()
+                try:
+                    item = json.loads(line)
+                except json.JSONDecodeError:
+                    continue
+                report(int(item.get("progress", 0)), item.get("message"), item.get("extra") or {})
+    except FileNotFoundError:
+        pass
+    return offset
+
+
+def main(argv: list[str] | None = None) -> None:
+    """One rank: run the normal training job; rank 0 writes progress lines for :func:`launch`."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--spec", required=True)
+    parser.add_argument("--dataset", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--cache", required=True)
+    parser.add_argument("--progress", required=True)
+    args = parser.parse_args(argv)
+
+    from training.job import TrainingJobSpec, run_training_job
+
+    spec = TrainingJobSpec.model_validate_json(Path(args.spec).read_text())
+    rank = int(os.environ.get("RANK", "0"))
+    progress_path = Path(args.progress)
+
+    def report(progress: int, message: str | None, extra: dict[str, Any]) -> None:
+        if rank != 0:
+            return
+        line = json.dumps({"progress": progress, "message": message, "extra": extra}, default=str)
+        with progress_path.open("a") as handle:
+            handle.write(line + "\n")
+
+    def never_stop() -> bool:
+        # Cancelling a Modal job stops the whole container; a per-rank stop could make ranks diverge.
+        return False
+
+    run_training_job(
+        spec,
+        dataset_root=args.dataset,
+        output_dir=args.output,
+        cache_dir=args.cache,
+        report=report,
+        should_stop=never_stop,
+    )
+    # Done (rank 0 has published and exported; the others returned after training). Exit at once:
+    # interpreter shutdown (NCCL teardown, worker threads) is where the 8-GPU run hung on 2026-11-14,
+    # and torchrun only returns when every rank has exited.
+    sys.stdout.flush()
+    sys.stderr.flush()
+    os._exit(0)
+
+
+if __name__ == "__main__":
+    main()
