+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: Apache-2.0
+
+"""Full checkpoints stay where PHYSICALAI_FULL_CHECKPOINT_DIR points; weights-only copies ship."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import torch
+
+from training import job
+
+
+def _write_checkpoint(path: Path) -> dict:
+    state = {
+        "global_step": 7,
+        "state_dict": {"layer.weight": torch.ones(4, 4)},
+        "optimizer_states": [{"state": {0: {"exp_avg": torch.zeros(4, 4)}}}],
+        "lr_schedulers": [{"last_epoch": 7}],
+        "hyper_parameters": {"width": 4},
+    }
+    torch.save(state, path)
+    return state
+
+
+def test_without_target_nothing_changes(tmp_path: Path, monkeypatch) -> None:
+    monkeypatch.delenv(job.FULL_CHECKPOINT_DIR_ENV, raising=False)
+    checkpoint = tmp_path / job.CHECKPOINT_NAME
+    _write_checkpoint(checkpoint)
+    before = checkpoint.read_bytes()
+    job._offload_full_checkpoints(tmp_path)
+    assert checkpoint.read_bytes() == before
+
+
+def test_full_checkpoint_kept_and_weights_shipped(tmp_path: Path, monkeypatch) -> None:
+    cache_dir, keep_dir = tmp_path / "cache", tmp_path / "keep"
+    cache_dir.mkdir()
+    monkeypatch.setenv(job.FULL_CHECKPOINT_DIR_ENV, str(keep_dir))
+    _write_checkpoint(cache_dir / job.CHECKPOINT_NAME)
+
+    job._offload_full_checkpoints(cache_dir)
+
+    full = torch.load(keep_dir / job.CHECKPOINT_NAME, weights_only=False)
+    slim = torch.load(cache_dir / job.CHECKPOINT_NAME, weights_only=False)
+    assert full["optimizer_states"] and full["lr_schedulers"]
+    assert "optimizer_states" not in slim and "lr_schedulers" not in slim
+    assert slim["global_step"] == 7
+    assert torch.equal(slim["state_dict"]["layer.weight"], torch.ones(4, 4))
+    assert not list(cache_dir.glob("*.tmp"))
